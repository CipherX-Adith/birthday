# ==============================================================================
# Birthday Web Project - Git Ignore
# ==============================================================================

# OS & System Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# Editor & IDE Configs
# ------------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Dependencies & Package Managers
# ------------------------------------------------------------------------------
node_modules/
jspm_packages/
.pnp/
.pnp.js

# Build Artifacts & Caches
# ------------------------------------------------------------------------------
dist/
build/
out/
.cache/
.parcel-cache/
.eslintcache/

# Logs & Diagnostics
# ------------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment Variables & Secrets
# ------------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem

# Temporary & Scratch Files
# ------------------------------------------------------------------------------
*.tmp
*.bak
*.orig
scratch/
.system_generated/
